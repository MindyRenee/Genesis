# Genesis sudoers drop-in — passwordless sudo for her user.
#
# Every privileged lever invokes `sudo -n` directly: the daemon's
# body control (governor, EPP, nice, I/O class, RTC wake alarm),
# the run_privileged tool (`sudo -n bash`), and the optional-deps
# installer. There is no mediated helper — a rule scoped to bash
# would still permit all of root, so the honest choice is the full
# grant or none. Without it, sensing still works; only actuation
# stays read-only.
#
# This is a TEMPLATE — substitute the installing user:
#
#   sed 's/REPLACE_WITH_USERNAME/'"$USER"'/' scripts/genesis-sudoers \
#       | sudo tee /etc/sudoers.d/genesis
#   sudo chmod 440 /etc/sudoers.d/genesis
#   sudo visudo -c          (verify syntax)
#
# Revoke with:  sudo rm /etc/sudoers.d/genesis

REPLACE_WITH_USERNAME ALL=(ALL) NOPASSWD: ALL
