#!/bin/bash
# Run Genesis — start and stop everything from one script.
#
# This is the only supported way to start and stop Genesis.
# Starting launches the daemon, cognitive CLI, retina, and TTS.
# Ctrl-C in the running terminal tears them all down.
#
# Usage: ./genesis            (wake Genesis)
#        ./genesis wake       (the same, spelled out)
#        ./genesis --stop     (stop a running Genesis)
#        ./genesis --offline  (wake in offline mode)
#        ./genesis --game     (wake already in game mode — the
#                             competition sitting: focused play,
#                             self-directed activity starved, the
#                             network sealed, sleep fought through
#                             her own chemistry)
# Flags combine with the verb in any order: ./genesis wake --offline
#
# Optional: put a Discord channel webhook URL in .genesis-discord
# (gitignored) or export GENESIS_DISCORD_WEBHOOK to give her a public
# channel — it mirrors the terminal session and carries the posts she
# composes (broadcasts, drawings, project announcements). To let the
# public talk back to her there, export GENESIS_DISCORD_BOT_TOKEN or
# put the bot token in .genesis-discord-bot — a webhook is
# write-only, so hearing the channel needs the bot identity.

set -m

# Resolve through any symlink so a linked invocation still lands on the
# real checkout (the launch path below is relative to it).
cd "$(dirname "$(readlink -f "$0")")" || exit 1

# An exported-but-blank GENESIS_DATA_DIR is treated as unset; otherwise
# it is the only override of the one canonical state directory,
# ~/.local/share/genesis. There is no pin file and no XDG step — see
# src/data_dir.rs and infrastructure/config.py, which implement the same
# single rule.
if [ -n "${GENESIS_DATA_DIR:-}" ] && [ -z "${GENESIS_DATA_DIR//[[:space:]]/}" ]; then
    unset GENESIS_DATA_DIR
fi

# Same pattern for the Discord channel: an uncommitted, gitignored
# .genesis-discord file holds the webhook URL so the secret stays out
# of the repo and shell history. Explicit GENESIS_DISCORD_WEBHOOK
# always wins.
if [ -z "${GENESIS_DISCORD_WEBHOOK:-}" ] && [ -f .genesis-discord ]; then
    GENESIS_DISCORD_WEBHOOK=$(head -n1 .genesis-discord)
    export GENESIS_DISCORD_WEBHOOK
fi

# And the same for her ear: .genesis-discord-bot holds the bot token
# that lets her hear the public on the channel. Explicit
# GENESIS_DISCORD_BOT_TOKEN always wins.
if [ -z "${GENESIS_DISCORD_BOT_TOKEN:-}" ] && [ -f .genesis-discord-bot ]; then
    GENESIS_DISCORD_BOT_TOKEN=$(head -n1 .genesis-discord-bot)
    export GENESIS_DISCORD_BOT_TOKEN
fi

# The one rule, in one line: GENESIS_DATA_DIR if set, else the canonical
# ~/.local/share/genesis. readlink -m canonicalizes (., .., relative)
# without requiring the directory to exist — so --stop works on a dir
# that was never created, and no interpreter is needed this early.
DATA_DIR="$(readlink -m "${GENESIS_DATA_DIR:-$HOME/.local/share/genesis}")"

# ─── PID-file helpers ────────────────────────────────────────────────
# The CLI writes PID files for itself, the daemon, and the retina to
# the data dir. We use these to kill exact processes instead of broad
# pkill patterns that could match unrelated user processes (e.g.
# "aplay", "piper", "retina" run by other applications).

# Read a PID from a PID file. Returns 0 and echoes the PID if the file
# exists and the PID is alive; returns 1 otherwise.
_read_pid() {
    local pidfile="$1"
    [ -f "$pidfile" ] || return 1
    local pid
    pid=$(cat "$pidfile" 2>/dev/null) || return 1
    _matches_pid "$pid" "$pidfile" || return 1
    echo "$pid"
    return 0
}

_matches_pid() {
    local pid="$1" pidfile="$2" i
    [[ "$pid" =~ ^[1-9][0-9]{0,9}$ ]] && [ "$pid" -gt 1 ] || return 1
    local -a args=()
    mapfile -d '' -t args < "/proc/$pid/cmdline" 2>/dev/null || return 1
    [ "${#args[@]}" -gt 0 ] || return 1
    case "${pidfile##*/}" in
        genesis_cli.pid)
            [[ "${args[0]##*/}" == python* ]] || return 1
            # The dev entry point (python genesis_cli.py) and the
            # installed console script (python .../bin/genesis) are
            # the same process — the --data-dir check below still
            # binds identity to this instance.
            [[ "${args[1]:-}" == */genesis_cli.py || "${args[1]:-}" == genesis_cli.py || "${args[1]:-}" == */genesis || "${args[1]:-}" == genesis ]] || return 1
            ;;
        genesis_daemon.pid)
            [ "${args[0]##*/}" = genesis-daemon ] || return 1
            ;;
        genesis_retina.pid)
            [ "${args[0]##*/}" = retina ] || return 1
            # Primary identity: stdout redirected to this instance's
            # retina.log. Log rotation renames the file, so the fd may
            # point at a rotated/deleted inode — fall back to the
            # --data-dir argument match below in that case.
            if [[ "$(readlink "/proc/$pid/fd/1" 2>/dev/null)" == "$DATA_DIR/retina.log"* ]]; then
                return 0
            fi
            ;;
        *) return 1 ;;
    esac
    for ((i=1; i < ${#args[@]}; i++)); do
        case "${args[i]}" in
            --data-dir)
                # An explicit --data-dir decides identity exactly:
                # match or fail — never fall through to the implicit
                # check below, or a process bound to a different
                # directory would be claimed by this instance.
                [ $((i + 1)) -lt ${#args[@]} ] || return 1
                [ "$(readlink -m "${args[i+1]}")" = "$DATA_DIR" ] && return 0 || return 1
                ;;
            --data-dir=*)
                # argparse also accepts the equals form.
                [ "$(readlink -m "${args[i]#--data-dir=}")" = "$DATA_DIR" ] && return 0 || return 1
                ;;
        esac
    done
    # A process launched without --data-dir resolved internally:
    # GENESIS_DATA_DIR else the canonical dir. Replicate that from the
    # target's own environment rather than comparing against our
    # defaults — a process whose env resolves somewhere else is not
    # ours no matter what we would have resolved. An unreadable
    # environ means the process is not ours to claim either.
    local env_dir="" env_home="" line resolved
    while IFS= read -r line; do
        case "$line" in
            GENESIS_DATA_DIR=*) env_dir="${line#GENESIS_DATA_DIR=}" ;;
            HOME=*)             env_home="${line#HOME=}" ;;
        esac
    done < <(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null)
    env_dir="${env_dir#"${env_dir%%[![:space:]]*}"}"
    env_dir="${env_dir%"${env_dir##*[![:space:]]}"}"
    if [ -n "$env_dir" ]; then
        resolved="$(readlink -m "$env_dir")"
    elif [ -n "$env_home" ]; then
        resolved="$(readlink -m "$env_home/.local/share/genesis")"
    else
        return 1
    fi
    [ "$resolved" = "$DATA_DIR" ] && return 0 || return 1
}

# Echo every matching PID — the pidfile's first (it is the freshest
# identity), then any further /proc matches. Plural matters: retina
# holds no lock, so a second matching process must be found rather than
# silently surviving a --stop.
_find_pids() {
    local pidfile="$1" entry pid
    _read_pid "$pidfile" 2>/dev/null
    for entry in /proc/[0-9]*/cmdline; do
        pid="${entry#/proc/}"
        pid="${pid%/cmdline}"
        if _matches_pid "$pid" "$pidfile" 2>/dev/null; then
            echo "$pid"
        fi
    done
}

# Request graceful shutdown of every matching process and wait for them
# all to exit. If signaling fails or shutdown takes too long, preserve
# all files and return failure. A successful signal alone does not
# establish that a process has finished saving state; never escalate
# to SIGKILL.
_kill_pidfile() {
    local pidfile="$1"
    local signal="$2"
    local pid deadline
    local -a pids=()
    mapfile -t pids < <(_find_pids "$pidfile" | sort -un)
    [ "${#pids[@]}" -gt 0 ] || return 0
    for pid in "${pids[@]}"; do
        kill -"$signal" "$pid" 2>/dev/null || return 1
    done
    deadline=$((SECONDS + 120))
    for pid in "${pids[@]}"; do
        while _matches_pid "$pid" "$pidfile" 2>/dev/null; do
            if [ "$SECONDS" -ge "$deadline" ]; then
                echo "  Shutdown still pending for PID $pid; state and locks preserved." >&2
                return 1
            fi
            sleep 1
        done
    done
    return 0
}

# ─── Stop helper ─────────────────────────────────────────────────────
# Tear down every Genesis process for this data dir.
# Prefers validated PID files; falls back to exact /proc arguments
# for this data directory if PID files are missing or stale.
_stop_all() {
    local cli_pidfile="$DATA_DIR/genesis_cli.pid"
    local daemon_pidfile="$DATA_DIR/genesis_daemon.pid"
    local retina_pidfile="$DATA_DIR/genesis_retina.pid"

    # 0. Tell the body's mind-shepherd this absence is authored —
    #    an orphaned daemon past the CLI's death must not regrow a
    #    mind the operator is putting down (src/daemon/mind_shepherd.rs).
    printf 'stopped %s\n' "$(date +%s%3N)" > "$DATA_DIR/mind.suppress" 2>/dev/null || true

    # 1. Stop the cognitive CLI first (it owns the daemon lifecycle).
    #    Validate PID files and fall back to exact /proc arguments.
    #    Each step has its own 120s grace period; a failure returns
    #    immediately so daemon/retina may be left running — retry
    #    ./genesis --stop after the CLI finishes saving state.
    _kill_pidfile "$cli_pidfile" INT || { echo "  CLI shutdown pending; retry --stop once it exits." >&2; return 1; }

    # 2. The helper waits for the CLI to finish before proceeding.

    # 3. Gracefully stop orphaned children only after the CLI exits.
    #    Keep their PID files on failure so shutdown can be retried.
    #    Never interrupt an in-progress cognitive state save.
    _kill_pidfile "$daemon_pidfile" TERM || { echo "  Daemon shutdown pending; state preserved, retry --stop." >&2; return 1; }
    _kill_pidfile "$retina_pidfile" TERM || { echo "  Retina shutdown pending; retry --stop." >&2; return 1; }

    # Fallback discovery is handled by _find_pids using /proc arguments.
    # Exact data-directory matching avoids regex metacharacters and
    # whitespace confusing unrelated processes with this instance.
    # Retina is identified by its executable and per-instance log,
    # not by a project-wide process-name pattern.
    # Voice subprocess cleanup remains the cognitive CLI's responsibility.

    # 4. Leave lock inodes intact; the owning processes clean their sockets.
    return 0
}

# Check whether any Genesis process is running for this data dir.
_is_running() {
    local cli_pidfile="$DATA_DIR/genesis_cli.pid"
    local daemon_pidfile="$DATA_DIR/genesis_daemon.pid"
    local retina_pidfile="$DATA_DIR/genesis_retina.pid"
    [ -n "$(_find_pids "$cli_pidfile")" ] && return 0
    [ -n "$(_find_pids "$daemon_pidfile")" ] && return 0
    [ -n "$(_find_pids "$retina_pidfile")" ] && return 0
    return 1
}

# ─── Parse arguments ─────────────────────────────────────────────────
# Scan all args for flags so order doesn't matter. This prevents
# silent misbehavior when the user passes e.g. ./genesis --offline --stop
# (which would otherwise try to START Genesis instead of stopping it).
WANT_STOP=0
OFFLINE_ARG=""
GAME_ARG=""
for arg in "$@"; do
    case "$arg" in
        wake)      : ;;  # the explicit verb — starting is the default act
        --stop)    WANT_STOP=1 ;;
        --offline) OFFLINE_ARG="--offline" ;;
        --game)    GAME_ARG="--game" ;;
        *) echo "  Unknown argument: $arg" >&2; exit 2 ;;
    esac
done

# ─── Handle --stop ───────────────────────────────────────────────────
if [ "$WANT_STOP" -eq 1 ]; then
    if _is_running; then
        echo "  Stopping Genesis..."
        _stop_all || exit 1
        echo "  Genesis stopped."
    else
        echo "  Genesis is not running."
    fi
    exit 0
fi

mkdir -p "$DATA_DIR" || exit 1

# Guard against two checkouts sharing one mind. The data dir records
# which project tree created it; a different tree reusing it would
# corrupt both developmental records. Warn loudly — do not refuse,
# because deliberately moving or sharing state is legitimate.
MARKER="$DATA_DIR/.project_root"
if [ -f "$MARKER" ]; then
    marker_content="$(cat "$MARKER" 2>/dev/null || true)"
    if [ -n "$marker_content" ] && [ "$marker_content" != "$PWD" ]; then
        echo "  WARNING: this data dir was created by a different checkout:"
        echo "    $marker_content"
        echo "  This instance's state belongs to that tree. Two checkouts"
        echo "  sharing one data dir corrupt each other's developmental"
        echo "  record."
        echo "  To point this checkout elsewhere, export GENESIS_DATA_DIR"
        echo "  — the only override of the canonical location. Otherwise"
        echo "  remove the state if you really intend to continue from here."
    fi
else
    echo "$PWD" > "$MARKER"
fi

# Refuse to start if a Genesis mind is already running for this data dir.
# Only the CLI blocks a new start: a surviving daemon/retina with no CLI
# is the body outliving its last mind — the CLI adopts it rather than
# being refused, so mind and body are never deliberately kept apart.
# A CLI mid-teardown still matches here and refuses, which is correct:
# a new start must never interrupt a state save.
if [ -n "$(_find_pids "$DATA_DIR/genesis_cli.pid")" ]; then
    echo "  Genesis is already running. Stop it with: ./genesis --stop"
    exit 1
fi

# Existing retina processes for this instance are checked above.
# Do not signal camera processes belonging to another data directory.

# EXIT trap — report unfinished shutdown without interrupting state saves.
# The CLI owns child cleanup. If startup loses a singleton-lock race,
# this shell must not stop the winning instance or unlink its locks.
_atexit() {
    # Use validated process identities when checking for remaining work.
    if _is_running; then
        echo "  Genesis processes remain; use ./genesis --stop for graceful shutdown." >&2
    fi
    # Preserve socket/lock/PID files for their owners and later recovery.
}

trap _atexit EXIT

# ── Pre-flight: build the release binaries from the current source ──
# There is one canonical build: `cargo build --release`. No debug
# fallback. Do this on every start: Cargo's incremental build makes an
# unchanged tree a no-op, while a changed source tree cannot accidentally
# run an older daemon binary. This matters for the memory-mapped state
# schema: source and binary must agree on the on-disk layout.
RELEASE_BIN="target/release/genesis-daemon"
echo "[genesis] Building release binaries from the current source..."
cargo build --release || {
    echo "[genesis] Build failed. Genesis cannot start."
    exit 1
}
if [ ! -x "$RELEASE_BIN" ]; then
    echo "[genesis] Release binary was not produced at $RELEASE_BIN"
    exit 1
fi

# Only genesis is allowed to launch the CLI.
export GENESIS_WAKE=1

# Start Genesis — voice and ambient listening always on.
# Ctrl-C in this terminal sends SIGINT to the foreground CLI, which
# shuts down the daemon and retina before exiting; the EXIT trap
# reports any processes still needing a graceful shutdown.
#
# OFFLINE_ARG was parsed from the command line above (--offline for
# no network access), GAME_ARG likewise (--game to boot already in
# game mode).
#
# One interpreter for every launch path: the installed venv is the
# canonical runtime — created with --system-site-packages, it sees
# everything system python does plus its own pinned overrides, so
# dev runs and the service can never drift onto different deps.
# No fallback — a missing venv is a failed install, not a cue to
# silently run on a different dependency set.
VENV_PY="${GENESIS_INSTALL_HOME:-$HOME/.local/lib/genesis}/venv/bin/python"
if [ ! -x "$VENV_PY" ]; then
    echo "[genesis] $VENV_PY not found — run scripts/install.sh first"
    exit 1
fi
PYTHONPATH="$PWD/python:${PYTHONPATH:-}" "$VENV_PY" genesis_cli.py --data-dir "$DATA_DIR" ${OFFLINE_ARG:+$OFFLINE_ARG} ${GAME_ARG:+$GAME_ARG}
